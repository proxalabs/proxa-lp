# Copy this file to .env and fill in the values. Never commit .env.

# ── Database ───────────────────────────────────────
# Local development: `npm run db:up` starts Postgres in Docker on port 5433.
DATABASE_URL=postgres://proxa:proxa@127.0.0.1:5433/proxa_site

# ── Payload CMS ────────────────────────────────────
# Long random strings. Generate each with: openssl rand -hex 32
PAYLOAD_SECRET=
PREVIEW_SECRET=

# ── Site URL + social share image ──────────────────
# Production origin for canonical URLs, the sitemap and Open Graph tags.
# Defaults to https://www.proxalabs.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.proxalabs.com
# Absolute URL to a ~1200x630 share image. Defaults to <site>/og-default.png.
NEXT_PUBLIC_OG_IMAGE=

# ── Email (form notifications) ─────────────────────
# Gmail / Google Workspace SMTP. Create an app password at
# https://myaccount.google.com/apppasswords (not your regular password).
# When SMTP_EMAIL is unset, emails are written to the server log instead.
SMTP_EMAIL=no-reply@insitehub.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Sender shown in inboxes. Must be the SMTP mailbox or a verified send-as alias.
FROM_NAME=Proxa Labs Website
FROM_EMAIL=no-reply@insitehub.com
# Where contact / newsletter / form notifications go (comma-separated).
NOTIFY_EMAIL=sales@insitehub.com,john.royer@insitehub.com
# Innovation Collective registrations (comma-separated).
EVENT_NOTIFY_EMAIL=mehrler@proxalabs.com,mercy@ehrlermarketingadvisory.com

# ── Analytics ──────────────────────────────────────
# GA4 Measurement ID. Tracking is off in development and on localhost.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional Google Tag Manager container.
NEXT_PUBLIC_GTM_ID=

# ── Sentry (optional) ──────────────────────────────
# Public browser DSN from the Sentry project settings.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
